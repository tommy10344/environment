#!/bin/sh

set -x

# Xcode
xcode-select --install

# Homebrew
brew update
brew upgrade
brew upgrade --cask
brew cleanup
# brew doctor

# Node.js
# npm 本体は volta が node 同梱版を管理する(npm install -g npm で上げると、既定の node が対応しない版になり npm / npx が ERR_REQUIRE_ESM で動かなくなる)
npm install -g yarn
npm install -g http-server
npm install -g npm-check-updates
npm install -g firebase-tools
volta setup

# Ruby
gem update
rbenv rehash

# Golang
go get -u github.com/nsf/gocode

# Neovim
nvim +UpdatePlugin +UpdateRemotePlugins +qa

# Flutter
flutter upgrade
